# 이 파일을 .env 로 복사해 값을 채운다. .env 는 저장소와 배포에 올라가지 않는다.
# LLM_PROVIDER: openai, gemini, claude, fake 중 하나. fake 는 키 없이 가짜 응답을 돌려준다.
LLM_PROVIDER=fake
LLM_API_KEY=
# 비워 두면 제공자별 기본 모델을 쓴다
LLM_MODEL=
ENV=local

# 저장소와 로그인. 처음에는 memory, none 으로 둔다. Supabase 연결은 docs/supabase.md
STORAGE=memory
AUTH=none
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
GOOGLE_LOGIN=false

# 크레딧(N056). 가입 때 원장에 한 번 쌓는 무료 크레딧
FREE_CREDITS=30

# 결제(N056). 토스페이먼츠 결제위젯 연동 문서의 코드 예제에 공개된 '문서용 테스트 키'를 한 세트로 넣는다.
# 클라이언트 키(test_gck_…)는 화면에 넘겨도 되지만, 시크릿 키(test_gsk_…)는 서버만 읽는다.
# 배포에서는 시크릿 키를 Secret Manager 에 두고 이름으로 연결한다. 내 상점 키로 바꿀 때는 값만 바꾼다.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
